# Base URL of the Nexus backend (no trailing slash). Leave blank in simulated mode.
VITE_API_BASE_URL=http://localhost:8000

# "false" (default) = simulated demo runs (instant, no auth, no API cost).
# "true" = call the real backend. Visitors need an invite link to run live
# research (see `python -m app.admin`); without one they get the simulated demo.
VITE_LIVE_MODE=false

# Backend configuration. Copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
# Local Postgres (async driver):
DATABASE_URL=postgresql+asyncpg://nexus:password@localhost:5432/nexus
# Set true for managed Postgres that requires SSL (e.g. Neon). Off locally.
DATABASE_SSL=false

# --- Auth ---
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated frontend origins allowed to call the API. Empty = no browser access.
# Local dev frontend:
CORS_ORIGINS=http://localhost:5173

# --- Agent providers ---
# Required for real research runs; without them /research/query returns 503.
GEMINI_API_KEY=
TAVILY_API_KEY=
MODEL_NAME=gemini-2.5-flash

# --- Orchestration tuning (optional; sensible defaults if omitted) ---
# CAP=5
# MAX_ITERS=5
# MAX_CONCURRENCY=3
# PLANNER_RETRY_CAP=2
# PER_RESEARCHER_TIMEOUT=120
# GLOBAL_TIMEOUT=300

# --- Transient-error retry/backoff (optional) ---
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=0.5
# RETRY_MAX_DELAY=8.0

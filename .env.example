# Backend configuration. Copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
# Local Postgres (async driver):
DATABASE_URL=postgresql+asyncpg://nexus:password@localhost:5432/nexus
# Set true for managed Postgres that requires SSL (e.g. Neon). Off locally.
DATABASE_SSL=false

# --- Auth ---
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated frontend origins allowed to call the API. Empty = no browser access.
# Local dev frontend:
CORS_ORIGINS=http://localhost:5173

# --- Demo accounts ---
# No public signup: create accounts and invite links with `uv run python -m app.admin`.
# FRONTEND_URL is the base of those links (https://<frontend>/invite/<token>).
FRONTEND_URL=http://localhost:5173
# Defaults for a new account (each can be changed per account with app.admin update).
# DEFAULT_BUDGET_USD=0.50
# DEFAULT_ACCESS_DAYS=14

# --- Search provider ---
# Required for real research runs; without it /research/query returns 503.
TAVILY_API_KEY=

# --- LLM provider ---
# Which engine to use: openrouter | gemini | groq | cerebras | sambanova. All run
# through one OpenAI-compatible adapter.
# Default = openrouter: a paid key where each call reports its cost, which is billed
# to the demo account that made it. Give the key a hard credit limit on OpenRouter:
# that limit caps the total bill, the per-account budgets split it fairly.
LLM_PROVIDER=openrouter
# Optional: any OpenRouter model id (default: google/gemini-3.1-flash-lite).
# LLM_MODEL=

# Provider keys (only the selected one is required). The free-tier ones are handy
# for local development; set MAX_CONCURRENCY=1 with them.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# --- Orchestration tuning (optional; sensible defaults if omitted) ---
# CAP=3
# MAX_ITERS=3
# MAX_CONCURRENCY=3
# PLANNER_RETRY_CAP=2
# PER_RESEARCHER_TIMEOUT=150
# GLOBAL_TIMEOUT=300

# --- Transient-error retry/backoff (optional) ---
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=0.5
# RETRY_MAX_DELAY=8.0

# Backend configuration. Copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
# Local Postgres (async driver):
DATABASE_URL=postgresql+asyncpg://nexus:password@localhost:5432/nexus
# Set true for managed Postgres that requires SSL (e.g. Neon). Off locally.
DATABASE_SSL=false

# --- Auth ---
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated frontend origins allowed to call the API. Empty = no browser access.
# Local dev frontend:
CORS_ORIGINS=http://localhost:5173

# --- Demo accounts ---
# No public signup: create accounts and invite links with `uv run python -m app.admin`.
# FRONTEND_URL is the base of those links (https://<frontend>/invite/<token>).
FRONTEND_URL=http://localhost:5173
# Defaults for a new account (each can be changed per account with app.admin update).
# DEFAULT_BUDGET_USD=0.50
# DEFAULT_ACCESS_DAYS=14

# --- Uploaded documents (Cloudflare R2, S3-compatible) ---
# The extracted text goes in Postgres; the original file goes in this bucket.
# Unset means uploads are refused with a clear message, and the rest of the app
# still runs. Create an R2 bucket and an API token with object read/write.
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexus-documents
# MAX_UPLOAD_MB=10
# MAX_DOCUMENTS_PER_CONVERSATION=10
# MAX_DOCUMENT_CHARS=200000
# Scanned pages are read by OCR, at about three seconds a page.
# MAX_OCR_PAGES=10

# --- Search provider ---
# Two ways to give the agents the web. Setting SEARXNG_URL and CRAWL4AI_URL
# selects the self-hosted pair; otherwise TAVILY_API_KEY is used. Without
# either, /research/query returns 503.
#
# Self-hosted (free): `docker compose -f docker-compose.search.yml up -d`.
# SearXNG is the index, Crawl4AI reads a page and returns pruned markdown.
# SEARXNG_URL=http://localhost:8080
# CRAWL4AI_URL=http://localhost:11235
# Only if the Crawl4AI server was started with authentication on.
# CRAWL4AI_TOKEN=
# A metasearch query answers in about a second; reading a page starts a browser.
# SEARCH_TIMEOUT=20
# PAGE_READ_TIMEOUT=60

# The paid fallback, kept so a deployment can move over one environment at a time.
TAVILY_API_KEY=

# --- LLM provider ---
# Which engine to use: openrouter | gemini | groq | cerebras | sambanova. All run
# through one OpenAI-compatible adapter.
# Default = openrouter: a paid key where each call reports its cost, which is billed
# to the demo account that made it. Give the key a hard credit limit on OpenRouter:
# that limit caps the total bill, the per-account budgets split it fairly.
LLM_PROVIDER=openrouter
# Optional: any OpenRouter model id (default: google/gemini-3.1-flash-lite).
# LLM_MODEL=

# Provider keys (only the selected one is required). The free-tier ones are handy
# for local development; set MAX_CONCURRENCY=1 with them.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# --- Orchestration tuning (optional; sensible defaults if omitted) ---
# CAP=3
# MAX_ITERS=3
# MAX_CONCURRENCY=3
# PLANNER_RETRY_CAP=2
# RESEARCH_BUDGET=120
# PER_RESEARCHER_TIMEOUT=150
# WRITER_TIMEOUT=150
# GLOBAL_TIMEOUT=420

# --- Transient-error retry/backoff (optional) ---
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=0.5
# RETRY_MAX_DELAY=8.0

# --- Jobs ---
# redis (default): the API queues each job on Redis and the worker runs it:
#   uv run arq app.worker.WorkerSettings
# inline: jobs run inside the API process, for a quick setup without Redis.
# JOB_QUEUE=redis
REDIS_URL=redis://localhost:6379
# WORKER_MAX_JOBS=10

# --- Evals (uv run python -m app.evals) ---
# The judge that scores eval runs: any OpenRouter model id with structured outputs,
# billed to OPENROUTER_API_KEY. Try another judge on runs you already collected:
#   EVAL_JUDGE_MODEL=<model id> uv run python -m app.evals score evals_runs/<run id>
# Required to judge (score, run, compare); the app itself never reads it.
# gpt-oss-120b cost about a sixth of gpt-5-mini and matched its verdicts on 90% of
# a 6-golden slice (2026-09-14).
EVAL_JUDGE_MODEL=openai/gpt-oss-120b

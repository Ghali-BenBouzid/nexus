# Backend configuration. Copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
# Local Postgres (async driver):
DATABASE_URL=postgresql+asyncpg://nexus:password@localhost:5432/nexus
# Set true for managed Postgres that requires SSL (e.g. Neon). Off locally.
DATABASE_SSL=false

# --- Auth ---
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated frontend origins allowed to call the API. Empty = no browser access.
# Local dev frontend:
CORS_ORIGINS=http://localhost:5173

# --- Search provider ---
# Required for real research runs; without it /research/query returns 503.
TAVILY_API_KEY=

# --- LLM provider ---
# Which engine to use: gemini | groq | cerebras | sambanova. All run through one
# OpenAI-compatible adapter; per-model free-tier rate limits live in
# app/research/dependencies.py and are paced by a token+request-aware limiter.
# Default = gemini (gemini-3.1-flash-lite): reliable native tool-calling + a very
# high free TPM (~250k), so it produces real cited reports in ~80s. Its low ~15 RPM
# is paced by the limiter; free daily cap is 500 requests (~30-40 runs/day). Picked
# over gemini-2.5-flash, whose free tier is only 20 requests/day (~1 run).
# (Groq's free tier has the opposite problem — high RPM but low TPM: the reliable
#  models there are too token-starved to finish, and the high-TPM ones emit
#  malformed tool calls. Gemini avoids both.)
LLM_PROVIDER=gemini
# Optional: override the provider's default model (gemini -> gemini-3.1-flash-lite).
# LLM_MODEL=

# Provider keys (only the selected one is required):
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
SAMBANOVA_API_KEY=

# --- Orchestration tuning (optional; sensible defaults if omitted) ---
# Defaults are kept small for ~2-3 min runs on a low free-tier TPM. MAX_CONCURRENCY
# is bounded by tokens-per-minute (parallel researchers starve each other); raise
# CAP / MAX_ITERS / MAX_CONCURRENCY on a higher-TPM / paid tier for deeper, faster runs.
# CAP=3
# MAX_ITERS=3
# MAX_CONCURRENCY=1
# PLANNER_RETRY_CAP=2
# PER_RESEARCHER_TIMEOUT=150
# GLOBAL_TIMEOUT=300

# --- Transient-error retry/backoff (optional) ---
# RETRY_MAX_ATTEMPTS=3
# RETRY_BASE_DELAY=0.5
# RETRY_MAX_DELAY=8.0
